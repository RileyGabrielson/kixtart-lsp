; Loop examples
FUNCTION Main()
    ; For loop
    ? "Counting from 1 to 5:"
    FOR $i = 1 TO 5
        ? $i
    NEXT

    ; For loop with step
    ? "Counting from 10 to 1:"
    FOR $i = 10 TO 1 STEP -1
        ? $i
    NEXT

    ; While loop
    ? "While loop example:"
    $count = 0
    WHILE $count < 5
        ? "Count: " + $count
        $count = $count + 1
    WEND

    ; Nested loops
    ? "Multiplication table:"
    FOR $i = 1 TO 3
        FOR $j = 1 TO 3
            ? $i + " * " + $j + " = " + ($i * $j)
        NEXT
    NEXT

    ; Loop with break
    ? "Loop with break:"
    FOR $i = 1 TO 10
        IF $i == 5
            EXIT FOR
        ENDIF
        ? $i
    NEXT
ENDFUNCTION 