# Consolidated KiXtart Language Patterns

# Character Classes
letter = /[a-zA-Z]/
digit = /[0-9]/

# Basic Patterns
ws = " " | "\t" | "\n" | "\r"
ws_item = ws
ws_sequence = (ws_item)*

# Comment Characters
comment_char = letter | digit | " " | "\t" | "!" | "@" | "#" | "$" | "%" | "^" | "&" | "*" | "(" | ")" | "-" | "_" | "+" | "=" | "[" | "]" | "{" | "}" | "|" | "\\" | ";" | ":" | "'" | "\"" | "<" | ">" | "," | "." | "?" | "/"
comment_chars = (comment_char)*
comment = ";" + comment_chars + "\n"

# Program Structure
line_terminator = ws_sequence | comment | (ws_sequence + comment)
line_terminators = (line_terminator)*

# Identifier Components
identifier_start = letter | "_"
identifier_char = letter | digit | "_"
identifier_rest = (identifier_char)*
identifier = identifier_start + identifier_rest

# Variable
variable = "$" + identifier

# System Variable
system_variable = "@" + identifier

# Number
digit_sequence = (digit)*
number = digit_sequence

# String Characters
string_char = letter | digit | " " | "\t" | "!" | "@" | "#" | "$" | "%" | "^" | "&" | "*" | "(" | ")" | "-" | "_" | "+" | "=" | "[" | "]" | "{" | "}" | "|" | "\\" | ";" | ":" | "'" | "<" | ">" | "," | "." | "?" | "/"
string_chars = (string_char)*
string = "\"" + string_chars + "\""

# Array Patterns
array_size = "[" + ws_sequence + number + ws_sequence + "]"
array_index = "[" + ws_sequence + (number | variable | expression) + ws_sequence + "]"
array_access = variable + array_index
array_assignment = array_access + ws_sequence + "=" + ws_sequence + expression

# Function Arguments
function_arg = string | number | variable | array_access | system_variable
arg_separator = ws_sequence + "," + ws_sequence
function_arg_list_item = arg_separator + function_arg
function_args = function_arg + (function_arg_list_item)*

# Function Call
function_call_no_args = identifier + "(" + ws_sequence + ")"
function_call_with_args = identifier + "(" + ws_sequence + function_args + ws_sequence + ")"
function_call = function_call_no_args | function_call_with_args

# Expression Components
expression_value = number | string | variable | array_access | system_variable | function_call | ("(" + ws_sequence + expression + ws_sequence + ")")
binary_operator = "+" | "-" | "*" | "/" | "%" | "^" | "==" | "!=" | "<" | ">" | "<=" | ">="
binary_operation = ws_sequence + binary_operator + ws_sequence + expression_value
expression = expression_value + (binary_operation)*

# Control Structures
if_condition = expression
if_body_statement = statement + line_terminators
if_body = (if_body_statement)*
else_clause = "ELSE" + if_body
if_statement = "IF" + ws_sequence + if_condition + if_body + (else_clause)* + "ENDIF"

for_variable = variable
for_collection = variable | array_access | function_call
for_body_statement = statement + line_terminators
for_body = (for_body_statement)*
for_each_statement = "FOR" + ws_sequence + "EACH" + ws_sequence + for_variable + ws_sequence + "IN" + ws_sequence + for_collection + line_terminators + for_body + "NEXT"

# Statement Components
assignment = variable + ws_sequence + "=" + ws_sequence + expression
output = "?" + ws_sequence + expression
dim_statement = "DIM" + ws_sequence + variable + array_size
statement = assignment | array_assignment | output | dim_statement | function_call | if_statement | for_each_statement

# Function Components
function_param = variable
function_param_list_item = arg_separator + function_param
function_params = function_param + (function_param_list_item)*
function_param_list = "(" + ws_sequence + function_params + ws_sequence + ")"
function_no_params = "(" + ws_sequence + ")"
function_header = "FUNCTION" + ws_sequence + identifier + (function_param_list | function_no_params)

# Function Body
function_body_statement = statement + line_terminators
function_body = line_terminators + (function_body_statement)* 
function_definition = function_header + function_body + "ENDFUNCTION"

# Program Components
program_content = function_definition | statement
program_item = program_content + line_terminators
program_items = line_terminators + (program_item)*
program = program_items
