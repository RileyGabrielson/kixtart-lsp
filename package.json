{
  "name": "kixtart-language-support",
  "displayName": "KiXtart Language Support",
  "description": "Language support for KiXtart scripting language",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:kixtart"
  ],
  "main": "./client/out/extension",
  "contributes": {
    "languages": [{
      "id": "kixtart",
      "aliases": ["KiXtart", "kixtart"],
      "extensions": [".kix"],
      "configuration": "./language-configuration.json"
    }]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -b",
    "watch": "tsc -b -w",
    "postinstall": "cd client && npm install && cd ../server && npm install"
  },
  "devDependencies": {
    "@types/node": "^16.11.7",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "eslint": "^8.35.0",
    "typescript": "^5.0.2"
  }
}
